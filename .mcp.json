{
	"mcpServers": {
		"sequential-thinking": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			]
		},
		"playwright": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			]
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"@21st-dev/magic": {
			"command": "npx",
			"args": [
				"-y",
				"@21st-dev/magic@latest",
				"API_KEY=cb8d9fe7056bfc98b12a19caa0eac78aff53a51db403d8280da7df9bc003347a"
			]
		},
		"mongo-atlas": {
			"command": "npx",
			"args": [
				"-y",
				"--package=mongodb-mcp-server",
				"mongodb-mcp-server"
			],
			"env": {
				"MONGODB_URI": "mongodb+srv://mahaumaster:mahaumaster12345@cluster0.aodlpub.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0",
				"MONGODB_DBNAME": "lessonplans_dev_new"
			}
		},
		"postgresql": {
			"command": "npx",
			"args": [
				"-y",
				"--package=@modelcontextprotocol/server-postgres",
				"mcp-server-postgres",
				"postgresql://admin:admin123@db_postgres:5432/lessonplans_dev?sslmode=disable"
			]
		}
	}
